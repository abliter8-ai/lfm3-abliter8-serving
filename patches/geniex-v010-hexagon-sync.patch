+// IP-305 sync transport: one batch per FastRPC invoke. The descriptor block travels as an inrout
+// argument (FastRPC does the cache maintenance), so no dspqueue buffer flags are needed. VTCM is
+// acquired and released for every synchronous batch; this avoids carrying a cached VTCM lease
+// across FastRPC calls and preserves the resource-manager release semantics.
+AEEResult htp_iface_execute(remote_handle64 handle, const uint8_t * req_b, int req_len, uint8_t * blk, int blk_len, uint8_t * rsp_b, int rsp_len) {
+    struct htp_handle * h = (struct htp_handle *) handle;
+    if (!h || !h->ctx) {
+        return AEE_EBADPARM;
+    }
+    if (req_len < (int) sizeof(struct htp_opbatch_req) || rsp_len < (int) sizeof(struct htp_opbatch_rsp) || !blk || blk_len <= 0) {
+        FARF(ERROR, "execute: bad arg sizes req %d blk %d rsp %d", req_len, blk_len, rsp_len);
+        return AEE_EBADPARM;
+    }
+    struct htp_context * ctx = h->ctx;
+    if (ctx->dsp_queue) {
+        FARF(ERROR, "execute: session runs the dspqueue transport");
+        return AEE_EUNSUPPORTED;
+    }
+
+    struct htp_opbatch_req req;
+    memcpy(&req, req_b, sizeof(req));
+
+    struct dspqueue_buffer dbuf;
+    memset(&dbuf, 0, sizeof(dbuf));
+    dbuf.ptr  = blk;
+    dbuf.size = (uint32_t) blk_len;
+
+    if (ctx->vtcm_needs_release) {
+        vtcm_release(ctx);
+    }
+    vtcm_acquire(ctx);
+
+    struct htp_opbatch_rsp rsp;
+    bool ok = process_opbatch_core(ctx, &req, &dbuf, &rsp);
+
+    vtcm_release(ctx);
+
+    if (!ok) {
+        return AEE_EBADPARM;
+    }
+    memcpy(rsp_b, &rsp, sizeof(rsp));
+    return AEE_SUCCESS;
+}
